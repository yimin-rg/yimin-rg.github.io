<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yimin 個人網站</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            line-height: 1.6;
            background: linear-gradient(135deg, #ffffff 0%, #fef7f7 50%, #f0fdf4 100%);
            min-height: 100vh;
        }

        /* 導航欄 */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 1rem 2rem;
            z-index: 1000;
            transition: all 0.3s ease;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2563eb;
            text-decoration: none;
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        .nav-item {
            cursor: pointer;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: #374151;
            font-weight: 500;
        }

        .nav-item:hover {
            background: rgba(37, 99, 235, 0.1);
            color: #2563eb;
            transform: translateY(-2px);
        }

        .nav-item.active {
            background: #2563eb;
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        /* 主要內容區 */
        .main-content {
            margin-top: 80px;
            padding: 2rem;
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
        }

        /* 首頁樣式 */
        .home-section {
            text-align: center;
            padding: 4rem 0;
        }

        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: linear-gradient(45deg, #f8b5d9, #a8e6cf);
            margin: 0 auto 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
            font-weight: bold;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        .profile-image:hover {
            transform: scale(1.05);
        }

        .intro-text {
            max-width: 600px;
            margin: 0 auto;
        }

        .intro-text h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: #1f2937;
            font-weight: 300;
        }

        .intro-text p {
            font-size: 1.1rem;
            color: #6b7280;
            line-height: 1.8;
        }

        /* 卡片網格樣式 */
        .content-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
            padding: 2rem 0;
        }

        .content-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            border: 1px solid rgba(0, 0, 0, 0.05);
            cursor: pointer;
        }

        .content-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
            border-color: rgba(37, 99, 235, 0.2);
        }

        .card-thumbnail {
            width: 100%;
            height: 200px;
            border-radius: 12px;
            background: linear-gradient(45deg, #f8b5d9, #a8e6cf);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
            transition: transform 0.3s ease;
        }

        .content-card:hover .card-thumbnail {
            transform: scale(1.02);
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 0.5rem;
        }

        .card-summary {
            color: #6b7280;
            line-height: 1.6;
            font-size: 0.95rem;
        }

        .card-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #f3f4f6;
            font-size: 0.875rem;
            color: #9ca3af;
        }

        /* 頁面標題 */
        .page-title {
            text-align: center;
            margin-bottom: 3rem;
        }

        .page-title h2 {
            font-size: 2.5rem;
            color: #1f2937;
            font-weight: 300;
            margin-bottom: 0.5rem;
        }

        .page-title p {
            color: #6b7280;
            font-size: 1.1rem;
        }

        /* 隱藏所有section */
        .section {
            display: none;
        }

        .section.active {
            display: block;
        }

        /* 響應式設計 */
        @media (max-width: 768px) {
            .navbar {
                padding: 1rem;
            }

            .nav-menu {
                gap: 1rem;
            }

            .nav-item {
                padding: 0.5rem;
                font-size: 0.9rem;
            }

            .main-content {
                padding: 1rem;
            }

            .content-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .intro-text h1 {
                font-size: 2rem;
            }

            .page-title h2 {
                font-size: 2rem;
            }
        }

        /* 滾動動畫 */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <!-- 導航欄 -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="#" class="logo">Yimin</a>
            <ul class="nav-menu">
                <li class="nav-item active" onclick="showSection('home')">首頁</li>
                <li class="nav-item" onclick="showSection('projects')">專案</li>
                <li class="nav-item" onclick="showSection('uva')">UVA題庫</li>
                <li class="nav-item" onclick="showSection('notes')">筆記</li>
                <li class="nav-item" onclick="showSection('thoughts')">心得</li>
            </ul>
        </div>
    </nav>

    <!-- 主要內容 -->
    <main class="main-content">
        <!-- 首頁 -->
        <section id="home" class="section active">
            <div class="home-section fade-in">
                <div class="profile-image">Y</div>
                <div class="intro-text">
                    <h1>Hello, I'm Yimin</h1>
                    <p>歡迎來到我的個人網站！我是一名熱愛程式設計和學習的開發者。
                    在這裡你可以找到我的專案作品、程式練習記錄、學習筆記以及個人心得分享。
                    希望我的經驗和想法能夠對你有所幫助，也歡迎與我交流討論！</p>
                </div>
            </div>
        </section>

        <!-- 專案頁面 -->
        <section id="projects" class="section">
            <div class="page-title fade-in">
                <h2>我的專案</h2>
                <p>展示我的程式設計作品和實作專案</p>
            </div>
            <div class="content-grid">
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🚀</div>
                    <h3 class="card-title">個人網站建置</h3>
                    <p class="card-summary">使用 HTML、CSS、JavaScript 建立響應式個人網站，包含現代化設計和流暢的用戶體驗...</p>
                    <div class="card-meta">
                        <span>2024-12-20</span>
                        <span>Web Development</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">📱</div>
                    <h3 class="card-title">待辦事項應用程式</h3>
                    <p class="card-summary">React 開發的待辦事項管理應用，支援任務分類、優先級設定和進度追蹤功能...</p>
                    <div class="card-meta">
                        <span>2024-11-15</span>
                        <span>React</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🤖</div>
                    <h3 class="card-title">聊天機器人</h3>
                    <p class="card-summary">Python 實現的智能聊天機器人，整合自然語言處理技術，提供智能對話體驗...</p>
                    <div class="card-meta">
                        <span>2024-10-08</span>
                        <span>Python</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- UVA題庫 -->
        <section id="uva" class="section">
            <div class="page-title fade-in">
                <h2>UVA 題庫練習</h2>
                <p>演算法問題解析和程式碼實現記錄</p>
            </div>
            <div class="content-grid">
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🧮</div>
                    <h3 class="card-title">UVA 100 - The 3n+1 Problem</h3>
                    <p class="card-summary">經典的 3n+1 問題解析，包含演算法思路、時間複雜度分析和最佳化策略討論...</p>
                    <div class="card-meta">
                        <span>2024-12-18</span>
                        <span>Easy</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🔢</div>
                    <h3 class="card-title">UVA 272 - TEX Quotes</h3>
                    <p class="card-summary">字串處理問題，學習如何處理引號轉換，包含字元替換和狀態追蹤的實作技巧...</p>
                    <div class="card-meta">
                        <span>2024-12-16</span>
                        <span>Easy</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🌟</div>
                    <h3 class="card-title">UVA 10114 - Loansome Car Buyer</h3>
                    <p class="card-summary">模擬問題解析，計算汽車貸款的月份數，涉及浮點數計算和迴圈控制的細節處理...</p>
                    <div class="card-meta">
                        <span>2024-12-14</span>
                        <span>Medium</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 筆記 -->
        <section id="notes" class="section">
            <div class="page-title fade-in">
                <h2>學習筆記</h2>
                <p>程式設計學習心得和技術筆記整理</p>
            </div>
            <div class="content-grid">
                <div class="content-card fade-in">
                    <div class="card-thumbnail">⚛️</div>
                    <h3 class="card-title">React Hooks 完整指南</h3>
                    <p class="card-summary">深入了解 React Hooks 的使用方法，包含 useState, useEffect, useContext 等常用 Hooks 的實作和最佳實踐...</p>
                    <div class="card-meta">
                        <span>2024-12-12</span>
                        <span>React</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🗃️</div>
                    <h3 class="card-title">資料結構與演算法</h3>
                    <p class="card-summary">整理常見的資料結構（陣列、鏈結串列、樹、圖）和演算法（排序、搜尋、動態規劃）的概念和實作...</p>
                    <div class="card-meta">
                        <span>2024-12-10</span>
                        <span>Algorithm</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🎨</div>
                    <h3 class="card-title">CSS Grid 與 Flexbox</h3>
                    <p class="card-summary">現代 CSS 佈局技術比較分析，包含 Grid 和 Flexbox 的使用場景、語法詳解和實際應用範例...</p>
                    <div class="card-meta">
                        <span>2024-12-08</span>
                        <span>CSS</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 心得 -->
        <section id="thoughts" class="section">
            <div class="page-title fade-in">
                <h2>個人心得</h2>
                <p>學習過程的反思和程式設計路上的感悟</p>
            </div>
            <div class="content-grid">
                <div class="content-card fade-in">
                    <div class="card-thumbnail">💭</div>
                    <h3 class="card-title">程式設計學習一年回顧</h3>
                    <p class="card-summary">回顧一年來的程式設計學習歷程，分享遇到的挑戰、解決問題的方法，以及對未來學習方向的規劃...</p>
                    <div class="card-meta">
                        <span>2024-12-15</span>
                        <span>Reflection</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🚶</div>
                    <h3 class="card-title">從零開始的前端之路</h3>
                    <p class="card-summary">分享從完全不懂程式設計到能夠建立網站的學習過程，包含學習資源推薦和學習方法心得...</p>
                    <div class="card-meta">
                        <span>2024-12-05</span>
                        <span>Journey</span>
                    </div>
                </div>
                <div class="content-card fade-in">
                    <div class="card-thumbnail">🎯</div>
                    <h3 class="card-title">如何保持程式設計的動機</h3>
                    <p class="card-summary">探討在學習程式設計過程中如何維持學習熱忱，分享克服挫折的方法和尋找學習樂趣的技巧...</p>
                    <div class="card-meta">
                        <span>2024-11-28</span>
                        <span>Motivation</span>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script>
        // 導航功能
        function showSection(sectionId) {
            // 隱藏所有section
            const sections = document.querySelectorAll('.section');
            sections.forEach(section => {
                section.classList.remove('active');
            });

            // 顯示選中的section
            document.getElementById(sectionId).classList.add('active');

            // 更新導航項目狀態
            const navItems = document.querySelectorAll('.nav-item');
            navItems.forEach(item => {
                item.classList.remove('active');
            });
            event.target.classList.add('active');

            // 重新觸發動畫
            setTimeout(() => {
                const fadeElements = document.querySelectorAll(`#${sectionId} .fade-in`);
                fadeElements.forEach(element => {
                    element.classList.add('visible');
                });
            }, 100);
        }

        // 滾動動畫
        function observeElements() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            });

            document.querySelectorAll('.fade-in').forEach(el => {
                observer.observe(el);
            });
        }

        // 卡片點擊效果
        function addCardClickEffect() {
            document.querySelectorAll('.content-card').forEach(card => {
                card.addEventListener('click', function() {
                    // 這裡可以添加點擊卡片後的行為
                    console.log('Card clicked:', this.querySelector('.card-title').textContent);
                });
            });
        }

        // 導航欄滾動效果
        function handleNavbarScroll() {
            const navbar = document.querySelector('.navbar');
            let lastScrollY = window.scrollY;

            window.addEventListener('scroll', () => {
                const currentScrollY = window.scrollY;
                
                if (currentScrollY > lastScrollY && currentScrollY > 100) {
                    navbar.style.transform = 'translateY(-100%)';
                } else {
                    navbar.style.transform = 'translateY(0)';
                }
                
                lastScrollY = currentScrollY;
            });
        }

        // 初始化
        document.addEventListener('DOMContentLoaded', function() {
            // 初始顯示首頁動畫
            setTimeout(() => {
                document.querySelectorAll('#home .fade-in').forEach(element => {
                    element.classList.add('visible');
                });
            }, 300);

            observeElements();
            addCardClickEffect();
            handleNavbarScroll();
        });
    </script>
</body>
</html>
